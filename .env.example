# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# Server
PORT=5000
NODE_ENV=development

# MySQL Database (from qserver.ng cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=basega_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.qserver.ng

# Upload storage (local folder)
UPLOAD_DIR=./uploads
