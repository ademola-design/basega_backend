# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=basega_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SSL=false
# For TLS databases such as Aiven, set DB_SSL=true and point this to its CA PEM file.
DB_SSL_CA=

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Development origins. In production, replace with exact HTTPS origins,
# comma-separated if apex and www are both used (no paths or trailing slash).
FRONTEND_URLS=http://localhost:5173,http://localhost:4173

# Set true only when the app is behind one trusted reverse proxy/load balancer.
TRUST_PROXY=false

# Upload storage (local folder)
UPLOAD_DIR=./uploads
